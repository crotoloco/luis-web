<%@ Page Language="C#" AutoEventWireup="true" CodeFile="clientes.aspx.cs" Inherits="clientes" %>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server"><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Entre Hojas | Clientes</title><link rel="stylesheet" href="css/entre-hojas-theme.css" /></head>
<body><form id="form1" runat="server"><div class="eh-page"><div class="page-heading"><span class="eyebrow">Comunidad</span><h1>Gestión de clientes</h1><p>Administrá los datos de las personas que forman parte de Entre Hojas.</p></div>
<asp:Panel ID="pnlActions" runat="server"><asp:Button ID="btnNuevo" runat="server" Text="Nuevo" CssClass="accion" OnClick="btnNuevo_Click" /><asp:Button ID="btnModificar" runat="server" Text="Modificar" CssClass="accion" OnClick="btnModificar_Click" /><asp:Button ID="btnEliminar" runat="server" Text="Eliminar" CssClass="accion btn-red" OnClick="btnEliminar_Click" /><asp:Button ID="btnGuardar" runat="server" Text="Guardar" CssClass="accion btn-green" OnClick="btnGuardar_Click" /><asp:Button ID="btnCancelar" runat="server" Text="Cancelar" CssClass="accion" OnClick="btnCancelar_Click" /><asp:Button ID="btnSalir" runat="server" Text="Salir" CssClass="accion btn-red" OnClick="btnSalir_Click" /></asp:Panel>
<asp:Label ID="lblMensaje" runat="server" CssClass="form-message" />
<div class="management-layout"><fieldset><legend>Datos personales</legend><asp:HiddenField ID="hfClienteId" runat="server" Value="-1" /><asp:Label ID="lblApellido" runat="server" Text="Apellido" CssClass="lbl" AssociatedControlID="txtApellido" /><asp:TextBox ID="txtApellido" runat="server" CssClass="input" MaxLength="50" /><asp:Label ID="lblNombre" runat="server" Text="Nombre" CssClass="lbl" AssociatedControlID="txtNombre" /><asp:TextBox ID="txtNombre" runat="server" CssClass="input" MaxLength="50" /><asp:Label ID="lblDni" runat="server" Text="DNI (8 caracteres)" CssClass="lbl" AssociatedControlID="txtDni" /><asp:TextBox ID="txtDni" runat="server" CssClass="input" MaxLength="8" /><asp:Label ID="lblCorreo" runat="server" Text="Correo" CssClass="lbl" AssociatedControlID="txtCorreo" /><asp:TextBox ID="txtCorreo" runat="server" CssClass="input" MaxLength="100" /><asp:Label ID="lblCelular" runat="server" Text="Celular (8 caracteres, sin 0 ni 15)" CssClass="lbl" AssociatedControlID="txtCelular" /><asp:TextBox ID="txtCelular" runat="server" CssClass="input" MaxLength="8" /><asp:Label ID="lblGenero" runat="server" Text="Género" CssClass="lbl" AssociatedControlID="ddlGenero" /><asp:DropDownList ID="ddlGenero" runat="server" CssClass="input"><asp:ListItem Text="Seleccione" Value="" /><asp:ListItem Text="Femenino" Value="Femenino" /><asp:ListItem Text="Masculino" Value="Masculino" /><asp:ListItem Text="Otro" Value="Otro" /></asp:DropDownList><asp:Label ID="lblCiudad" runat="server" Text="Ciudad" CssClass="lbl" AssociatedControlID="txtCiudad" /><asp:TextBox ID="txtCiudad" runat="server" CssClass="input" MaxLength="50" /><asp:Label ID="lblEstado" runat="server" Text="Estado" CssClass="lbl" AssociatedControlID="ddlEstado" /><asp:DropDownList ID="ddlEstado" runat="server" CssClass="input"><asp:ListItem Text="Activo" Value="Activo" /><asp:ListItem Text="Inactivo" Value="Inactivo" /><asp:ListItem Text="Moroso" Value="Moroso" /></asp:DropDownList></fieldset>
<div><fieldset class="filter-panel"><legend>Filtros de búsqueda</legend><asp:Label ID="lblFiltro" runat="server" Text="Apellido, nombre, DNI o correo" CssClass="lbl" AssociatedControlID="txtFiltro" /><asp:TextBox ID="txtFiltro" runat="server" CssClass="input" AutoPostBack="true" OnTextChanged="FiltroChanged" /></fieldset><div class="data-area"><asp:GridView ID="gvClientes" runat="server" CssClass="grid" AutoGenerateColumns="False" DataKeyNames="Id_cliente" OnSelectedIndexChanged="gvClientes_SelectedIndexChanged" AllowPaging="true" PageSize="10" OnPageIndexChanging="gvClientes_PageIndexChanging"><Columns><asp:CommandField ShowSelectButton="true" SelectText="Seleccionar" /><asp:BoundField DataField="Id_cliente" HeaderText="ID" /><asp:BoundField DataField="Apellido" HeaderText="Apellido" /><asp:BoundField DataField="Nombre" HeaderText="Nombre" /><asp:BoundField DataField="DNI" HeaderText="DNI" /><asp:BoundField DataField="Correo" HeaderText="Correo" /><asp:BoundField DataField="Genero" HeaderText="Género" /><asp:BoundField DataField="Ciudad" HeaderText="Ciudad" /><asp:BoundField DataField="Celular" HeaderText="Celular" /><asp:BoundField DataField="Estado" HeaderText="Estado" /></Columns></asp:GridView></div></div></div>
</div></form></body></html>
