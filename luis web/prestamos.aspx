<%@ Page Language="C#" AutoEventWireup="true" CodeFile="prestamos.aspx.cs" Inherits="prestamos" %>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server"><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Entre Hojas | Préstamos</title><link rel="stylesheet" href="css/entre-hojas-theme.css" /></head>
<body><form id="form1" runat="server"><div class="eh-page"><div class="page-heading"><span class="eyebrow">Biblioteca</span><h1>Gestión de préstamos</h1><p>Registrá y controlá los préstamos de libros.</p></div>
<asp:Panel ID="pnlActions" runat="server"><asp:Button ID="btnNuevo" runat="server" Text="Nuevo" CssClass="accion" OnClick="btnNuevo_Click" /><asp:Button ID="btnModificar" runat="server" Text="Modificar" CssClass="accion" OnClick="btnModificar_Click" /><asp:Button ID="btnEliminar" runat="server" Text="Eliminar" CssClass="accion btn-red" OnClick="btnEliminar_Click" /><asp:Button ID="btnGuardar" runat="server" Text="Guardar" CssClass="accion btn-green" OnClick="btnGuardar_Click" /><asp:Button ID="btnCancelar" runat="server" Text="Cancelar" CssClass="accion" OnClick="btnCancelar_Click" /><asp:Button ID="btnSalir" runat="server" Text="Salir" CssClass="accion btn-red" OnClick="btnSalir_Click" /></asp:Panel>
<asp:Label ID="lblMensaje" runat="server" CssClass="form-message" />
<div class="management-layout"><fieldset><legend>Datos del préstamo</legend><asp:HiddenField ID="hfPrestamoId" runat="server" Value="-1" /><asp:Label ID="lblCliente" runat="server" Text="Cliente" CssClass="lbl" AssociatedControlID="ddlCliente" /><asp:DropDownList ID="ddlCliente" runat="server" CssClass="input" /><asp:Label ID="lblLibro" runat="server" Text="Libro" CssClass="lbl" AssociatedControlID="ddlLibro" /><asp:DropDownList ID="ddlLibro" runat="server" CssClass="input" /><asp:Label ID="lblFechaInicio" runat="server" Text="Fecha de inicio" CssClass="lbl" AssociatedControlID="txtFechaInicio" /><asp:TextBox ID="txtFechaInicio" runat="server" CssClass="input" TextMode="Date" /><asp:Label ID="lblFechaFin" runat="server" Text="Fecha de devolución" CssClass="lbl" AssociatedControlID="txtFechaFin" /><asp:TextBox ID="txtFechaFin" runat="server" CssClass="input" TextMode="Date" /><asp:Label ID="lblEstado" runat="server" Text="Estado" CssClass="lbl" AssociatedControlID="ddlEstado" /><asp:DropDownList ID="ddlEstado" runat="server" CssClass="input"><asp:ListItem Text="Pendiente" Value="Pendiente" /><asp:ListItem Text="Activo" Value="Activo" /><asp:ListItem Text="Devuelto" Value="Devuelto" /></asp:DropDownList></fieldset>
<div><fieldset class="filter-panel"><legend>Filtros de búsqueda</legend><asp:Label ID="lblFiltro" runat="server" Text="Cliente o libro" CssClass="lbl" AssociatedControlID="txtFiltro" /><asp:TextBox ID="txtFiltro" runat="server" CssClass="input" AutoPostBack="true" OnTextChanged="FiltroChanged" /><asp:Label ID="lblFiltroEstado" runat="server" Text="Estado" CssClass="lbl" AssociatedControlID="ddlFiltroEstado" /><asp:DropDownList ID="ddlFiltroEstado" runat="server" CssClass="input" AutoPostBack="true" OnSelectedIndexChanged="FiltroChanged"><asp:ListItem Text="Todos" Value="" /><asp:ListItem Text="Pendiente" Value="Pendiente" /><asp:ListItem Text="Activo" Value="Activo" /><asp:ListItem Text="Devuelto" Value="Devuelto" /></asp:DropDownList></fieldset><div class="data-area"><asp:GridView ID="gvPrestamos" runat="server" CssClass="grid" AutoGenerateColumns="False" DataKeyNames="ID_Prestamo" OnSelectedIndexChanged="gvPrestamos_SelectedIndexChanged" AllowPaging="true" PageSize="10" OnPageIndexChanging="gvPrestamos_PageIndexChanging"><Columns><asp:CommandField ShowSelectButton="true" SelectText="Seleccionar" /><asp:BoundField DataField="ID_Prestamo" HeaderText="ID" /><asp:BoundField DataField="Cliente" HeaderText="Cliente" /><asp:BoundField DataField="Libro" HeaderText="Libro" /><asp:BoundField DataField="Fecha_Inicio" HeaderText="Inicio" DataFormatString="{0:dd/MM/yyyy}" /><asp:BoundField DataField="Fecha_Fin" HeaderText="Devolución" DataFormatString="{0:dd/MM/yyyy}" /><asp:BoundField DataField="Estado" HeaderText="Estado" /></Columns></asp:GridView></div></div></div>
</div></form></body></html>
